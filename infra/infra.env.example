# Copy to infra/infra.env (gitignored) and edit before recreate.
# Both Terraform and the Snowflake setup scripts read these values.

# --- AWS / S3 layout (change these to relocate the project prefix) ---
AWS_REGION=us-east-1
# AWS_PROFILE=default
BUCKET_NAME=so3-data
ROOT_PREFIX=imss_bienestar

# Comma-separated source folders created under ROOT_PREFIX/
SOURCE_FOLDERS=camunda,sagi,invoicing,payments,banking,institution_status

# IAM role Snowflake assumes (name only; account is yours)
SNOWFLAKE_ROLE_NAME=snowflake-s3-imss-bienestar

# --- Snowflake objects ---
SNOWSQL_CONN=eseotres
SF_DATABASE=ESEOTRES_PHARMA
SF_SCHEMA=SRC_IMSS_BIENESTAR
SF_ROLE=SYSADMIN
INTEGRATION_NAME=s3_imss_bienestar
STAGE_NAME=eseotres_sources

# Derived automatically if unset:
# S3_URL=s3://${BUCKET_NAME}/${ROOT_PREFIX}/
